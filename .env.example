# Copy to .env and fill in.

# Your name as it appears in the scoring app (Ahmed, Usama, Bilal, Haider, Hamad, Wali).
# Leave blank and run `npm run whoami` after syncing wearable data to have it detected.
ME=

# The squash league history, imported once (your scoring app's public state endpoint).
SCORES_URL=https://club-squash-league.vercel.app/api/state

# Google Health API OAuth client (Fitbit data). See README "Connect your Fitbit".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_PORT=8787

# Optional tuning
# HR_MAX=195              # your max heart rate; defaults to the highest HR seen in your matches
# GAME_BREAK_SECONDS=90   # rest between games (PSA rule is 90s)

# Web app (`npm run serve` locally; on Vercel set these under Settings -> Environment Variables)
# APP_PASSWORD=           # required: protects your data
# SESSION_SECRET=         # recommended on Vercel: any long random string
# PUBLIC_URL=             # on Vercel: https://<your-project>.vercel.app
# CRON_SECRET=            # optional: turns on the nightly sync on Vercel

# AI coach (optional). Model and monthly budget are picked in the app's Settings.
# OPENAI_API_KEY=         # from platform.openai.com -> API keys
# OPENAI_MODEL=           # offer a model besides GPT-5.6 Luna/Terra/Sol
